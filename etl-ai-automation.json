    {
      "parameters": {
        "jsCode": "// Iterate through all items coming into the Code node\nfor (let item of $input.all()) {\n  // Adjust 'output' to match the actual property name containing your AI response string\n  let rawData = item.json.output || item.json.text || item.json;\n\n  let parsedData;\n  try {\n    // Handle cases where the JSON is wrapped in a string or markdown code blocks\n    if (typeof rawData === 'string') {\n      let cleanString = rawData\n        .replace(/```json/g, '')\n        .replace(/```/g, '')\n        .trim();\n      parsedData = JSON.parse(cleanString);\n    } else {\n      parsedData = rawData;\n    }\n\n    // Clean and normalize specific fields\n    if (parsedData.Email === \"INVALID_EMAIL\" || !parsedData.Email) {\n      parsedData.Email = null; // Set to null or leave empty string \"\"\n    }\n\n    // Example: Format Phone or convert data types if needed\n    parsedData.Fee_Paid = Boolean(parsedData.Fee_Paid);\n\n  } catch (error) {\n    // Fallback if JSON parsing fails\n    parsedData = { \n      parse_error: true, \n      message: error.message, \n      raw_output: rawData \n    };\n  }\n\n  // Assign the cleaned and parsed object back to the item json\n  item.json = parsedData;\n}\n\nreturn $input.all();"
      },
